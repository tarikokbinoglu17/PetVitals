# Supabase dashboard > Project Settings > API Keys
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Sağlayıcı ayarları tamamlanana kadar false bırakın.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false

# RevenueCat > Project > API keys. Bunlar public SDK anahtarlarıdır; secret key eklemeyin.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Copy this file to .env and fill in your own Supabase project's values.
# Get these from: Supabase Dashboard -> Project Settings -> API.
#
# EXPO_PUBLIC_ prefixed vars are inlined into the client bundle by Expo, so
# never put a real secret (like the service_role key) here. The anon key is
# meant to be public — Row Level Security policies are what actually protect
# the data (see supabase/migrations/0001_init.sql).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

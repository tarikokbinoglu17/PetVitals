{
  "expo": {
    "name": "PetVitals",
    "slug": "petvitals",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "petvitals",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.tarikokbinoglu.petvitals",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tarikokbinoglu.petvitals",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PetVitals, size en yakın veterinerleri ve petshopları gösterebilmek için konumunuzu yalnızca uygulamayı kullanırken kullanır."
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "PetVitals, size en yakın veterinerleri ve petshopları gösterebilmek için konumunuzu yalnızca uygulamayı kullanırken kullanır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetVitals, dostunuzun profil fotoğrafını seçebilmeniz için fotoğraflarınıza erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C735B",
          "defaultChannel": "vaccine-reminders"
        }
      ]
    ]
  }
}

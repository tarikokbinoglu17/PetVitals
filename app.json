{
  "expo": {
    "name": "PetVitals",
    "slug": "petvitals",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "petvitals",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.tarikokbinoglu.petvitals",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.tarikokbinoglu.petvitals",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PetVitals, size en yakın veterinerleri ve petshopları gösterebilmek için konumunuzu yalnızca uygulamayı kullanırken kullanır."
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "PetVitals, size en yakın veterinerleri ve petshopları gösterebilmek için konumunuzu yalnızca uygulamayı kullanırken kullanır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetVitals, dostunuzun profil fotoğrafını ve veteriner belgelerini seçebilmeniz için fotoğraflarınıza erişir.",
          "cameraPermission": "PetVitals, aşı karnesi ve veteriner belgelerini tarayabilmeniz için kamerayı kullanır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "PetVitals, yalnızca açık onayınızla veteriner görüşmesini kaydedip yazıya dökmek için mikrofona erişir.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C735B",
          "defaultChannel": "vaccine-reminders"
        }
      ]
    ],
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "ja": "./locales/ja.json"
    },
    "experiments": {
      "baseUrl": "/PetVitals"
    }
  }
}
